# ==============================================================================
# Biến môi trường hệ thống Hoài Thương Wedding
# Copy file này thành .env.local khi chạy local, hoặc cấu hình trên Render
# ==============================================================================

# 1. URL công khai của ứng dụng (không có dấu / ở cuối)
# Local:  http://localhost:3000
# Render: https://hoai-thuong-wedding.onrender.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# 2. Mã xác thực domain / tiền tố URL của Zalo (developers.zalo.me -> Xác thực domain)
NEXT_PUBLIC_ZALO_VERIFY_CODE=

# 3. Thông tin Zalo App (developers.zalo.me -> Cài đặt)
ZALO_APP_ID=
ZALO_APP_SECRET=

# ==============================================================================
# Phase 0B+ (Neon PostgreSQL Free Singapore & Cloudinary Free)
# ==============================================================================
# DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
# DATABASE_URL_UNPOOLED=postgresql://user:password@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
